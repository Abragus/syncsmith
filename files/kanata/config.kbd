(defsrc
{% if 'laptop' in tags -%}
  caps lmet rsft up
{% elif host == 'gdesktop' -%}
  caps lmet rsft pgdn pgup home end
{% else %}
  caps lmet
{% endif %}
)

(deflayermap (base)
  caps (fork ret caps (lmet))
  
{% if 'laptop' in tags -%}
  rsft up
  up   down
{% elif host == 'gdesktop' -%}
  rsft home
  pgdn end
  pgup rsft
  home pgup
  end pgdn
{% endif %}
)